{
  "manifest_version": 2,
  "name": "suravidl",
  "version": "0.3.0",
  "description": "Detect videos on any page and send them to your local suravidl engine.",
  "permissions": ["webRequest", "webRequestBlocking", "storage", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "options_ui": { "page": "options.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "suravidl@fritzkier.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
