<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing this app owns belongs on another device: the app-private files
     hold the cookie-session copy (the vault's whole point is that it stays
     encrypted at rest *here*), the engine token and the job history. A
     restored copy would also plant an undecryptable vault blob on the new
     device (v0.21.1 audit). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
